# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_org

# Backend connections (service names resolve inside the Docker network)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_org
REDIS_URL=redis://redis:6379/0

# Frontend -> backend (browser talks to the host-published port)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional API keys (Week 2 BA Agent) ---------------------------------
# Leave blank to run the full flow against built-in mock providers.
# Fill any/all in to switch that piece to live data automatically.
OPENAI_API_KEY=
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# --- Week 4 code-gen providers (optional; blank => falls back to OpenAI) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Code-gen cost mode ---------------------------------------------------
# real  = use the blueprint's locked routing (Claude for UI) — best quality,
#         ~$1.40 per build. Use this for demos.
# cheap = send every code-gen call to the budget model — ~$0.02 per build.
#         Use this while testing the pipeline. Default is "real".
CODEGEN_MODE=real

# --- Week 7 DevOps --------------------------------------------------------
# local = build + run the generated app as REAL Docker containers on this
#         machine (fully provable, $0). aws = real EC2 deploy (costs money).
DEPLOY_TARGET=local
PLATFORM_DOMAIN=example.com
APPS_SUBDOMAIN=apps.example.com
# Route53 hosted zone for apps.example.com (created for this project).
ROUTE53_ZONE_ID=
AWS_REGION=us-east-2
LETSENCRYPT_EMAIL=
# Fernet key (urlsafe base64, 32 bytes) encrypting secret VALUES at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Absent => the secrets store refuses to hold plaintext (never silently downgrades).
SECRETS_ENC_KEY=
